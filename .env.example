# Copy to .env to customize. All service ports are bound to 127.0.0.1 by
# default -- nothing is exposed to the network beyond your own machine.

# The course image. Pin this to a specific tag your class was tested
# against, not just the rolling ":2026". Example: :2026.1
TRAINBIGDATA_IMAGE=ghcr.io/bobbylovemovie/trainbigdata:2026

JUPYTER_PORT=8888
HDFS_UI_PORT=9870
YARN_UI_PORT=8088
HBASE_UI_PORT=16010
HIVE_PORT=10000

# Change to 0.0.0.0 only if you understand the security implications.
JUPYTER_HOST=127.0.0.1
HDFS_UI_HOST=127.0.0.1
YARN_UI_HOST=127.0.0.1
HBASE_UI_HOST=127.0.0.1
HIVE_HOST=127.0.0.1

# Memory made available to the container. Measured usage: ~2.2 GB with just
# core+MariaDB+JupyterLab, ~3.4 GB with everything running -- 6g leaves
# headroom without requiring a 16 GB laptop. See README "Resource usage".
MEM_LIMIT=6g
